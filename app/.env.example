# Скопируйте в app/.env.local (файл в .gitignore) и заполните.
# Без VITE_SUPABASE_* кабинет выключен: витрина работает без единого запроса наружу.

# Проект Supabase приложения (новый, не конвейерный). Оба значения попадают в сборку –
# anon-ключ публичный, доступ к данным охраняет только RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только для миграций и RLS-тестов с ноутбука (Session Pooler, порт 5432). В сборку не попадает.
SUPABASE_DB_URL=

# Второй Pages-сайт (SPEC-cabinet §7). По умолчанию git@github.com:<владелец origin>/abitura-china.git
# DEPLOY_REPO=git@github.com:owner/abitura-china.git
# DEPLOY_BRANCH=gh-pages

# Только для разработки: in-memory бэкенд кабинета без Supabase (вход без письма,
# демо-организация и ученики). В production-сборку не попадает.
# VITE_CABINET_FAKE=1
